{
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "language": "Japanese",
  "theme": "dark-daltonized",
  "outputStyle": "Maylac Operator",
  "voice": {
    "autoSubmit": false,
    "enabled": true,
    "mode": "hold"
  },
  "includeCoAuthoredBy": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "awaySummaryEnabled": false,
  "inputNeededNotifEnabled": true,
  "preferredNotifChannel": "terminal_bell",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "permissions": {
    "allow": [
      "Bash",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(command -v *)",
      "Bash(which *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current *)",
      "Bash(git worktree list *)"
    ],
    "ask": [
      "Bash(brew install *)",
      "Bash(brew uninstall *)",
      "Bash(gh pr create *)",
      "Bash(gh release *)",
      "Bash(git -C * push *)",
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "mcp__gbrain__delete_page",
      "mcp__gbrain__revert_version",
      "mcp__notebooklm-mcp__notebook_delete",
      "mcp__notebooklm-mcp__source_delete",
      "mcp__notebooklm-mcp__studio_delete"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(sudo *)",
      "Read(**/.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git -C * reset --hard *)"
    ]
  },
  "statusLine": {
    "command": "$HOME/.claude/statusline.py",
    "type": "command"
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.claude/hooks/instructions-loaded-audit.py",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "$HOME/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "type": "command"
          },
          {
            "async": true,
            "command": "$HOME/.agents/hooks/notify-mobile.sh idle Claude",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.agents/hooks/notify-mobile.sh approval Claude",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/compaction-recovery.py",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/compaction-recovery.py",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/untrusted-directory-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '$HOME/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "$HOME/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/agent-terminal-notify.sh Claude",
            "type": "command"
          },
          {
            "command": "$HOME/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "type": "command"
          },
          {
            "async": true,
            "command": "$HOME/.agents/hooks/notify-mobile.sh done Claude",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "type": "command"
          },
          {
            "async": true,
            "command": "$HOME/.agents/hooks/notify-mobile.sh error Claude",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.local/share/uv/tools/ccgram/bin/python -m ccgram.main hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/untrusted-directory-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/untrusted-directory-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": false,
    "aws-core@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "compact-plus@compact-plus-local": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "project-artifact@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.codex/auth.json",
        "~/.claude/.credentials.json"
      ],
      "denyWrite": [
        "~/.codex",
        "~/.claude"
      ]
    }
  }
}

{
  "permissions": {
    "allow": [
      "Bash(launchctl print:*)",
      "Bash(launchctl list:*)"
    ],
    "ask": [
      "Bash(launchctl bootstrap:*)",
      "Bash(launchctl bootout:*)",
      "Bash(launchctl kickstart:*)",
      "Bash(launchctl load:*)",
      "Bash(launchctl unload:*)",
      "Bash(launchctl enable:*)",
      "Bash(launchctl disable:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh auth:*)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *+*)",
      "Bash(gh repo delete:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth token:*)",
      "Bash(codex *--dangerously*)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/slack-bridge/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "~/.config/gh",
        "~/.config/slack-bridge"
      ]
    }
  }
}

#!/usr/bin/env python3
"""Read-only Cursor review launcher: always Ask mode, never force/yolo/sandbox overrides.

Usage:
  cursor-review -p PROMPT [--output-format text|json] [--model MODEL]
  cursor-review --help | --version | status
"""

import glob
import os
import re
import subprocess
import sys

UNSAFE_DIRS = ("Downloads", "Desktop")


class Refusal(Exception):
    pass


def find_binary(env):
    """Explicit CURSOR_REVIEW_BIN, else the newest native install. Never `agent` on PATH (may be Grok)."""
    if env.get("CURSOR_REVIEW_BIN"):
        return env["CURSOR_REVIEW_BIN"]
    home = env.get("HOME", os.path.expanduser("~"))
    found = sorted(glob.glob(os.path.join(home, ".local/share/cursor-agent/versions/*/cursor-agent")))
    if not found:
        raise Refusal("native Cursor CLI not found; set CURSOR_REVIEW_BIN")
    return found[-1]


def check_identity(binary):
    try:
        res = subprocess.run([binary, "--help"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Refusal("Cursor CLI --help unavailable: %s" % exc.__class__.__name__)
    text = res.stdout + res.stderr
    if res.returncode != 0 or not re.search(r"(?i)\bcursor\s+(?:cli|agent)\b", text):
        raise Refusal("configured binary does not identify itself as Cursor CLI")
    if "--mode" not in text or not re.search(r"\bask\b", text):
        raise Refusal("Cursor CLI does not advertise --mode ask")


def check_cwd(cwd, home):
    cwd, home = os.path.realpath(cwd), os.path.realpath(home)
    if cwd in (home, "/", "/tmp", "/private/tmp"):
        raise Refusal("run from a dedicated project directory, not %s" % cwd)
    for name in UNSAFE_DIRS:
        root = os.path.join(home, name)
        if cwd == root or cwd.startswith(root + os.sep):
            raise Refusal("refusing to review inside ~/%s (untrusted input)" % name)


def parse(args):
    """Allow only prompt, output format, optional model, and a redundant `--mode ask`."""
    prompt, fmt, model = None, "text", None
    i = 0
    while i < len(args):
        flag = args[i]
        val = args[i + 1] if i + 1 < len(args) else None
        if flag in ("-p", "--print") and val:
            prompt = val
        elif flag == "--output-format" and val in ("text", "json"):
            fmt = val
        elif flag == "--model" and val and not val.startswith("-"):
            model = val
        elif flag == "--mode" and val == "ask":
            pass
        else:
            raise Refusal("unsupported argument: %s" % flag)
        i += 2
    if not prompt:
        raise Refusal("expected -p PROMPT")
    return prompt, fmt, model


def build_command(binary, prompt, fmt, model):
    cmd = [binary, "--mode", "ask", "-p", prompt, "--output-format", fmt]
    return cmd + ["--model", model] if model else cmd


def main(argv=None, env=None):
    args = list(sys.argv[1:] if argv is None else argv)
    env = dict(os.environ if env is None else env)
    try:
        binary = find_binary(env)
        if args in (["--help"], ["--version"], ["status"]):
            os.execv(binary, [binary] + args)
        check_identity(binary)
        check_cwd(os.getcwd(), env.get("HOME", os.path.expanduser("~")))
        cmd = build_command(binary, *parse(args))
    except Refusal as exc:
        print("cursor-review: refused: %s" % exc, file=sys.stderr)
        return 2
    env["CROSS_HARNESS_PEER"] = "1"  # reviewer must not delegate further
    os.execve(cmd[0], cmd, env)
    return 127


if __name__ == "__main__":
    raise SystemExit(main())

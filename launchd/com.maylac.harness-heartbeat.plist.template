<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>Label</key>
  <string>com.maylac.harness-heartbeat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/scripts/harness-heartbeat.py</string>
    <string>--repo</string>
    <string>__REPO__</string>
    <string>--state-dir</string>
    <string>__HOME__/.local/state/harness-heartbeat</string>
    <string>--poll-file</string>
    <string>__HOME__/.local/state/slack-bridge/last_poll</string>
    <string>--launch-agents</string>
    <string>__HOME__/Library/LaunchAgents</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/harness-heartbeat/stderr.log</string>
</dict>
</plist>
